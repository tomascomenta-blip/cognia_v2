{
  "version": 1,
  "nombre": "ansi16",
  "nota": "accesibilidad: SOLO nombres de los 16 colores ANSI, para que la paleta de la terminal (y sus ajustes de accesibilidad) decida cada tono; sin glow ni animacion. El contraste depende de la paleta de la terminal, no se garantiza un piso.",
  "elementos": {
    "banner.arte": { "color": "ansigreen", "gradiente": ["ansigreen", "ansibrightgreen"], "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "banner.marco": { "color": "ansigreen", "estados": { "titulo": { "color": "ansibrightgreen" }, "version": { "color": "ansigreen" }, "subtitulo": { "color": "ansigreen" } } },
    "banner.guia": { "color": "ansicyan", "estados": { "cabecera": { "color": "ansibrightgreen" }, "regla": { "color": "ansigreen" }, "descripcion": { "color": "ansiwhite" }, "atajo": { "color": "ansigreen" }, "atajo_accion": { "color": "ansiwhite" } } },
    "banner.linea_modelo": { "color": "ansiwhite", "estados": { "sin_backend": { "color": "ansiyellow" } } },
    "prompt.marco": { "color": "ansigreen", "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "prompt.etiqueta": { "color": "ansibrightgreen", "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "prompt.flecha": { "color": "ansibrightgreen", "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "prompt.texto": { "color": "ansibrightgreen" },
    "prompt.continuacion": { "color": "ansibrightgreen" },
    "prompt.espera": { "color": "ansibrightgreen", "estados": { "aviso": { "color": "ansigreen" } } },
    "barra.estado": { "color": "ansigreen", "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "barra.estado.secciones": { "color": "ansigreen", "estados": { "modelo": { "color": "ansigreen" }, "dir": { "color": "ansigreen" }, "rama": { "color": "ansigreen" }, "sucio": { "color": "ansigreen" }, "ctx": { "color": "ansigreen" }, "ctx_alto": { "color": "ansigreen" }, "ctx_critico": { "color": "ansigreen" }, "tokens": { "color": "ansigreen" } } },
    "barra.atajos": { "color": "ansigreen", "estados": { "tecla": { "color": "ansigreen" }, "accion": { "color": "ansigreen" } } },
    "barra.modo": { "color": "ansigreen", "estados": { "plan": { "color": "ansigreen" }, "auto": { "color": "ansigreen" }, "manual": { "color": "ansigreen" } } },
    "menu.completado": { "color": "ansiwhite", "fondo": "ansiblue", "estados": { "activo": { "color": "ansibrightwhite", "fondo": "ansibrightblue" }, "meta": { "color": "ansiwhite", "fondo": "ansiblue" }, "meta_activo": { "color": "ansibrightwhite", "fondo": "ansibrightblue" }, "scrollbar": { "fondo": "ansiblue" }, "scrollbar_boton": { "fondo": "ansibrightblack" } } },
    "spinner.tool": { "color": "ansigreen", "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "spinner.pensar": { "color": "ansigreen", "glow": { "intensidad": 0 }, "animacion": { "activa": false } },
    "spinner.comando": { "color": "ansigreen" },
    "tool.ok": { "color": "ansigreen" },
    "tool.error": { "color": "ansibrightred" },
    "tool.curso": { "color": "ansiwhite" },
    "tool.verbo": { "color": "ansicyan" },
    "tool.objeto": { "color": "ansibrightwhite" },
    "tool.resultado": { "color": "ansiwhite" },
    "tool.intencion": { "color": "ansiwhite" },
    "pensando.prosa": { "color": "ansigreen" },
    "pensando.plegado": { "color": "ansigreen" },
    "aviso.degradado": { "color": "ansiyellow" },
    "aviso.info": { "color": "ansiwhite" },
    "aviso.error": { "color": "ansibrightred" },
    "footer.turno": { "color": "ansiwhite", "estados": { "ok": { "color": "ansigreen" }, "error": { "color": "ansibrightred" } } },
    "panel.borde": { "color": "ansigreen" },
    "panel.titulo": { "color": "ansibrightgreen" },
    "separador.regla": { "color": "ansiwhite" },
    "sistema.ok": { "color": "ansigreen" },
    "sistema.detalle": { "color": "ansiwhite" }
  }
}
