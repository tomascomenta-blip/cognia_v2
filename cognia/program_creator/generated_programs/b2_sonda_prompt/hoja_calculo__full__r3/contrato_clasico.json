{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de la grilla y celdas",
      "accion": "contar",
      "selector": ".grid",
      "esperado": 1,
      "critico": true
    },
    {
      "nombre": "Verificar que existen 9 celdas con clase .celda",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Confirmar que cada celda tiene atributo data-ref correcto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>['A1','A2','A3','B1','B2','B3','C1','C2','C3'].includes(el.getAttribute('data-ref')))",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Establecer valores iniciales y comprobar que se muestran",
      "accion": "texto",
      "selector": "#A1",
      "contiene": "0",
      "critico": true
    },
    {
      "nombre": "Ingresar fórmula en B1 y verificar cálculo",
      "accion": "texto",
      "selector": "#B1",
      "contiene": "=A1+1",
      "critico": true
    },
    {
      "nombre": "Cambiar valor de A1 y comprobar cascada en B1 y C1",
      "accion": "texto",
      "selector": "#A1",
      "contiene": "5",
      "critico": true
    },
    {
      "nombre": "Crear referencia circular y verificar que muestra CIRC",
      "accion": "texto",
      "selector": "#C1",
      "contiene": "=B1+1",
      "critico": true
    },
    {
      "nombre": "Modificar B1 para crear ciclo y comprobar que C1 muestra CIRC",
      "accion": "texto",
      "selector": "#B1",
      "contiene": "=C1+1",
      "critico": true
    }
  ]
}