      "selector": ".c[data-i='6'].bandera"
    },
    {
      "nombre": "Click en celda 6 no abre la mina",
      "critico": true,
      "accion": "contar_visible",
      "selector": ".c",
      "esperado": 9
    },
    {
      "nombre": "Estado: no se muestra 'perdiste' tras bandera",
      "critico": true,
      "accion": "texto",
      "selector": "#estado",
      "contiene": "perdiste",
      "esperado": false
    },
    {
      "nombre": "Click en celda 12 (mina) sin bandera",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 12
    },
    {
      "nombre": "Estado: se muestra 'perdiste' tras abrir mina",
      "critico": true,
      "accion": "texto",
      "selector": "#estado",
      "contiene": "perdiste",
      "esperado": true
