      "esperado": false
    },
    {
      "nombre": "Click en celda 0 (sin minas adyacentes)",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 0
    },
    {
      "nombre": "Cascada: todas las celdas adyacentes a 0 abiertas",
      "critico": true,
      "accion": "contar_visible",
      "selector": ".c",
      "esperado": 9
    },
    {
      "nombre": "Celdas con 0 minas adyacentes muestran texto vacío",
      "critico": true,
      "accion": "texto",
      "selector": ".c",
      "contiene": "0",
      "esperado": false
    },
    {
      "nombre": "Click derecho en celda 6 (mina)",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 6,
