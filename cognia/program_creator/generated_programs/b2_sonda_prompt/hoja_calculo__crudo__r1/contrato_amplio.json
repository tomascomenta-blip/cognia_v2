{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de la grilla y celdas",
      "critico": true,
      "accion": "contar",
      "selector": ".grid",
      "esperado": 1
    },
    {
      "nombre": "Verificar que existen 9 celdas con clase celda",
      "critico": true,
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9
    },
    {
      "nombre": "Comprobar que cada celda tiene atributo data-ref correcto",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).map(c=>c.dataset.ref).join(',')",
      "esperado": "A1,A2,A3,B1,B2,B3,C1,C2,C3"
    },
    {
      "nombre": "Confirmar que todas las celdas están vacías al inicio",
      "critico": true,
      "accion": "contar_visible",
      "selector": ".celda",
      "esperado": 0
    },
    {
      "nombre": "Ingresar valor 5 en A1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref=\"A1\"]",
      "contiene": "5"
    },
    {
      "nombre": "Ingresar fórmula =A1 en B1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref=\"B1\"]",
      "contiene": "=A1"
    },
    {
      "nombre": "Esperar cálculo de B1",
      "critico": true,
      "accion": "esperar",
      "ms": 200
    },
    {
      "nombre": "Verificar que B1 muestra 5",
      "critico": true,
      "accion": "contiene",
      "selector": "[data-ref=\"B1\"]",
      "contiene": "5"
    },
    {
      "nombre": "Ingresar fórmula =B1+1 en C1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref=\"C1\"]",
      "contiene": "=B1+1"
    },
    {
      "nombre": "Esperar cascada de cálculos",
      "critico": true,
      "accion": "esperar",
      "ms": 200
    },
    {
      "nombre": "Verificar que C1 muestra 6",
      "critico": true,
      "accion": "contiene",
      "selector": "[data-ref=\"C1\"]",
      "contiene": "6"
    },
    {
      "nombre": "Crear referencia circular: A1 =C1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref=\"A1\"]",
      "contiene": "=C1"
    },
    {
      "nombre": "Esperar detección de ciclo",
      "critico": true,
      "accion": "esperar",
      "ms": 200
    },
    {
      "nombre": "Verificar que A1 muestra CIRC",
      "critico": true,
      "accion": "contiene",
      "selector": "[data-ref=\"A1\"]",
      "contiene": "CIRC"
    },
    {
      "nombre": "Confirmar que B1 y C1 siguen mostrando 6 y 6 respectivamente",
      "critico": true,
      "accion": "contiene",
      "selector": "[data-ref=\"B1\"]",
      "contiene": "6"
    },
    {
      "nombre": "Restablecer A1 a 10 y verificar actualización de B1 y C1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref=\"A1\"]",
      "contiene": "10"
    },
    {
      "nombre": "Esperar cascada",
      "critico": true,
      "accion": "esperar",
      "ms": 200
    },
    {
      "nombre": "Verificar que B1 muestra 10 y C1 muestra 11",
      "critico": true,
      "accion": "contiene",
      "selector": "[data-ref=\"C1\"]",
      "contiene": "11"
    }
  ]
}