{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de la grilla y las celdas",
      "critico": true,
      "accion": "contar",
      "selector": ".grid",
      "esperado": 1
    },
    {
      "nombre": "Verificar que hay 9 celdas con clase .celda",
      "critico": true,
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9
    },
    {
      "nombre": "Confirmar que cada celda tiene atributo data-ref correcto",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>['A1','A2','A3','B1','B2','B3','C1','C2','C3'].includes(el.getAttribute('data-ref'))",
      "esperado": true
    },
    {
      "nombre": "Estado inicial: todas las celdas vacías",
      "critico": true,
      "accion": "contar_visible",
      "selector": ".celda",
      "esperado": 0
    },
    {
      "nombre": "Ingresar valor 5 en A1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='A1']",
      "contiene": "5"
    },
    {
      "nombre": "Ingresar valor 3 en B1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='B1']",
      "contiene": "3"
    },
    {
      "nombre": "Establecer fórmula =A1+B1 en C1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='C1']",
      "contiene": "=A1+B1"
    },
    {
      "nombre": "Verificar que C1 muestra 8",
      "critico": true,
      "accion": "contar_visible",
      "selector": "[data-ref='C1']",
      "esperado": 1
    },
    {
      "nombre": "Cambiar A1 a 10 y verificar cascada",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='A1']",
      "contiene": "10"
    },
    {
      "nombre": "Esperar 200ms para recalculo",
      "critico": true,
      "accion": "esperar",
      "ms": 200
    },
    {
      "nombre": "Verificar que C1 actualiza a 13",
      "critico": true,
      "accion": "contar_visible",
      "selector": "[data-ref='C1']",
      "esperado": 1
    },
    {
      "nombre": "Crear referencia circular: B1 =C1",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='B1']",
      "contiene": "=C1"
    },
    {
      "nombre": "Verificar que B1 muestra CIRC",
      "critico": true,
      "accion": "contar_visible",
      "selector": "[data-ref='B1']",
      "esperado": 1
    },
    {
      "nombre": "Eliminar referencia circular cambiando B1 a 7",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='B1']",
      "contiene": "7"
    },
    {
      "nombre": "Verificar que B1 muestra 7 y C1 actualiza a 17",
      "critico": true,
      "accion": "contar_visible",
      "selector": "[data-ref='C1']",
      "esperado": 1
    }
  ]
}