{
  "nombre": "Carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Existen 3 productos",
      "critico": true,
      "accion": "contar",
      "selector": ".prod",
      "esperado": 3
    },
    {
      "nombre": "Existen 3 botones 'add'",
      "critico": true,
      "accion": "contar",
      "selector": ".add",
      "esperado": 3
    },
    {
      "nombre": "Existen 3 productos con stock suficiente",
      "critico": true,
      "accion": "js",
      "expr": "document.querySelectorAll('.prod').every(p => parseInt(p.getAttribute('data-stock')) > 0)",
      "esperado": true
    },
    {
      "nombre": "Al añadir un producto, su cantidad se incrementa",
      "critico": true,
      "accion": "js",
      "selector": ".add",
      "indice": 0,
      "esperar": 1000,
      "expr": "document.querySelector('.linea[data-id=\"p1\"] .cant').textContent",
      "esperado": "1"
    },
    {
      "nombre": "Al añadir un producto con stock 0, el botón 'add' se deshabilita",
      "critico": true,
      "accion": "js",
      "selector": ".add",
      "indice": 2,
      "esperar": 1000,
      "expr": "document.querySelector('.add[data-id=\"p3\"]').disabled",
      "esperado": true
    },
    {
      "nombre": "Al quitar una unidad de un producto, su cantidad se decrementa",
      "critico": true,
      "accion": "js",
      "selector": ".quitar",
      "indice": 0,
      "esperar": 1000,
      "expr": "document.querySelector('.linea[data-id=\"p1\"] .cant').textContent",
      "esperado": "0"
    },
    {
      "nombre": "Al quitar una unidad de un producto a 0, la línea desaparece",
      "critico": true,
      "accion": "no_existe",
      "selector": ".linea[data-id=\"p1\"]",
      "indice": 0,
      "esperar": 1000
    },
    {
      "nombre": "El total se recalcula correctamente",
      "critico": true,
      "accion": "js",
      "selector": ".add",
      "indice": 1,
      "esperar": 1000,
      "expr": "document.getElementById('total').textContent",
      "esperado": "50"
    }
  ]
}