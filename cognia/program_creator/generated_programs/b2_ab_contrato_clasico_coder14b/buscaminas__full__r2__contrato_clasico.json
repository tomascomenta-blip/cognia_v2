{
  "nombre": "Contrato de prueba para buscaminas 5x5",
  "pasos": [
    {
      "nombre": "Existen 25 celdas con clase 'c'",
      "critico": true,
      "accion": "contar",
      "selector": ".c",
      "esperado": 25
    },
    {
      "nombre": "Las celdas tienen data-i de 0 a 24",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.c')).every(c => c.dataset.i >= 0 && c.dataset.i <= 24)",
      "esperado": true
    },
    {
      "nombre": "Las minas están en las celdas 6, 12 y 18",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.c')).filter(c => c.classList.contains('mina')).map(c => c.dataset.i).sort((a, b) => a - b).join(',') === '6,12,18'",
      "esperado": true
    },
    {
      "nombre": "Al hacer click en una celda sin minas, se revela el número de minas adyacentes",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 0,
      "esperado": {
        "min": 0,
        "max": 8
      }
    },
    {
      "nombre": "Si se abre una celda con 0 minas adyacentes, se abren también en cascada todas sus vecinas con 0",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 0,
      "esperado": {
        "min": 1,
        "max": 25
      }
    },
    {
      "nombre": "Click derecho pone una bandera en la celda",
      "critico": true,
      "accion": "tecla",
      "key": "ContextMenu",
      "selector": ".c",
      "indice": 0,
      "esperado": {
        "min": 1,
        "max": 25
      }
    },
    {
      "nombre": "Una celda con bandera no se abre al hacer click",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 0,
      "esperado": {
        "min": 0,
        "max": 25
      }
    },
    {
      "nombre": "Si se abre una mina, #estado dice 'perdiste'",
      "critico": true,
      "accion": "click",
      "selector": ".c",
      "indice": 6,
      "esperado": {
        "contiene": "perdiste"
      }
    }
  ]
}