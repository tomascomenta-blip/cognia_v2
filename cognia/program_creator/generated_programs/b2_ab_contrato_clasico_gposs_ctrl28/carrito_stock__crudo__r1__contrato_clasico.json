{
  "nombre": "Carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Estado inicial: 3 productos, 0 líneas en carrito, total 0",
      "critico": true,
      "pasos": [
        {
          "accion": "contar",
          "selector": ".prod",
          "esperado": 3
        },
        {
          "accion": "contar",
          "selector": ".add",
          "esperado": 3
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 0
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "0"
        }
      ]
    },
    {
      "nombre": "Agregar primer producto (p1)",
      "critico": true,
      "pasos": [
        {
          "accion": "click",
          "selector": ".add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 1
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "100"
        }
      ]
    },
    {
      "nombre": "Agregar mismo producto (p1) nuevamente",
      "critico": true,
      "pasos": [
        {
          "accion": "click",
          "selector": ".add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "texto",
          "selector": ".linea[data-id='p1'] .cant",
          "contiene": "2"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "200"
        }
      ]
    },
    {
      "nombre": "Intentar agregar p1 más allá del stock (2 unidades)",
      "critico": true,
      "pasos": [
        {
          "accion": "click",
          "selector": ".add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "existe",
          "selector": ".add[data-id='p1'][disabled]"
        }
      ]
    },
    {
      "nombre": "Agregar producto p2 (stock 3)",
      "critico": true,
      "pasos": [
        {
          "accion": "click",
          "selector": ".add[data-id='p2']",
          "indice": 0
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 2
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "250"
        }
      ]
    },
    {
      "nombre": "Quitar una unidad de p1",
      "critico": true,
      "pasos": [
        {
          "accion": "click",
          "selector": ".quitar[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "texto",
          "selector": ".linea[data-id='p1'] .cant",
          "contiene": "1"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "150"
        }
      ]
    },
    {
      "nombre": "Quitar última unidad de p1, línea desaparece",
      "critico": true,
      "pasos": [
        {
          "accion": "click",
          "selector": ".quitar[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "no_existe",
          "selector": ".linea[data-id='p1']"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "50"
        }
      ]
    },
    {
      "nombre": "Verificar que botón add de p1 se habilita nuevamente",
      "critico": true,
      "pasos": [
        {
          "accion": "existe",
          "selector": ".add[data-id='p1']"
        },
        {
          "accion": "no_existe",
          "selector": ".add[data-id='p1'][disabled]"
        }
      ]
    }
  ]
}