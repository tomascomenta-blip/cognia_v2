   "expr": "window.juego && typeof window.juego.largo==='number' && typeof window.juego.x==='number' && typeof window.juego.y==='number' && typeof window.juego.dir==='string'",
   "esperado": true
  },
  {
   "nombre": "Mover serpiente a la derecha con flecha",
   "critico": true,
   "accion": "tecla",
   "key": "ArrowRight"
  },
  {
   "nombre": "Verificar que la serpiente se haya movido una celda a la derecha",
   "critico": true,
   "accion": "js",
   "expr": "window.juego.x===1 && window.juego.y===0",
   "esperado": true
  },
