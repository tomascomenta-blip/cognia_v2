   "acciones": [
    {
     "accion": "click",
     "selector": ".c",
     "indice": 2
    },
    {
     "accion": "texto",
     "selector": "#estado",
     "contiene": "gana"
    },
    {
     "accion": "existe",
     "selector": "#estado"
    }
   ]
  },
  {
   "nombre": "Intentar marcar una casilla después de ganar y verificar que no cambia",
