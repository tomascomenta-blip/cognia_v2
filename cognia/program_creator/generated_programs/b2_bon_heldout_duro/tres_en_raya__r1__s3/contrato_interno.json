     "accion": "click",
     "selector": ".c",
     "indice": 1
    },
    {
     "accion": "texto",
     "selector": "#estado",
     "contiene": "X"
    }
   ]
  },
  {
   "nombre": "Completar una línea horizontal con X y verificar que el estado indica ganancia y las casillas quedan bloqueadas",
