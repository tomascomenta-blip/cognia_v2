{
  "nombre": "Carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Estado inicial: 3 productos y carrito vacío",
      "critico": true,
      "acciones": [
        {
          "accion": "contar",
          "selector": ".prod",
          "esperado": 3
        },
        {
          "accion": "contar",
          "selector": ".add",
          "esperado": 3
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 0
        },
        {
          "accion": "contiene",
          "selector": "#total",
          "contiene": "0"
        }
      ]
    },
    {
      "nombre": "Agregar primer producto (p1)",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 1
        },
        {
          "accion": "contiene",
          "selector": ".linea[data-id='p1'] .cant",
          "contiene": "1"
        },
        {
          "accion": "contiene",
          "selector": "#total",
          "contiene": "100"
        }
      ]
    },
    {
      "nombre": "Agregar mismo producto (p1) nuevamente",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "contiene",
          "selector": ".linea[data-id='p1'] .cant",
          "contiene": "2"
        },
        {
          "accion": "contiene",
          "selector": "#total",
          "contiene": "200"
        }
      ]
    },
    {
      "nombre": "Intentar superar stock de p1 (stock 2)",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "existe",
          "selector": ".add[data-id='p1'][disabled]"
        }
      ]
    },
    {
      "nombre": "Agregar segundo producto (p2) y verificar stock",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 1
        },
        {
          "accion": "contiene",
          "selector": ".linea[data-id='p2'] .cant",
          "contiene": "1"
        },
        {
          "accion": "contiene",
          "selector": "#total",
          "contiene": "250"
        }
      ]
    },
    {
      "nombre": "Quitar una unidad de p1",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0
        },
        {
          "accion": "contiene",
          "selector": ".linea[data-id='p1'] .cant",
          "contiene": "1"
        },
        {
          "accion": "contiene",
          "selector": "#total",
          "contiene": "150"
        }
      ]
    },
    {
      "nombre": "Quitar última unidad de p1 y comprobar desaparición",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0
        },
        {
          "accion": "no_existe",
          "selector": ".linea[data-id='p1']"
        },
        {
          "accion": "contiene",
          "selector": "#total",
          "contiene": "50"
        }
      ]
    },
    {
      "nombre": "Verificar que botón add de p1 se habilita tras quitar",
      "critico": true,
      "acciones": [
        {
          "accion": "existe",
          "selector": ".add[data-id='p1']"
        },
        {
          "accion": "no_existe",
          "selector": ".add[data-id='p1'][disabled]"
        }
      ]
    }
  ]
}