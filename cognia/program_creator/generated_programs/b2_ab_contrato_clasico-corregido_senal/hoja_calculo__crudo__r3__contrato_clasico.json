{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de 9 celdas",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Confirmar que cada celda tiene atributo data-ref correcto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>['A1','A2','A3','B1','B2','B3','C1','C2','C3'].includes(el.dataset.ref))",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Asegurar que el valor inicial de todas las celdas es vacío",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>el.value==='')",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Ingresar valor numérico en A1 y verificar que se muestra",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "5",
      "critico": true
    },
    {
      "nombre": "Escribir fórmula en B1 que dependa de A1 y comprobar cálculo",
      "accion": "texto",
      "selector": ".celda[data-ref='B1']",
      "contiene": "=A1+3",
      "critico": true
    },
    {
      "nombre": "Cambiar valor de A1 y verificar cascada en B1",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "10",
      "critico": true
    },
    {
      "nombre": "Crear referencia circular C1=B1+1 y B1=C1+1, verificar que ambas muestran 'CIRC'",
      "accion": "texto",
      "selector": ".celda[data-ref='C1']",
      "contiene": "=B1+1",
      "critico": true
    },
    {
      "nombre": "Eliminar referencia circular y comprobar que se actualiza a valor correcto",
      "accion": "texto",
      "selector": ".celda[data-ref='C1']",
      "contiene": "=A1+1",
      "critico": true
    }
  ]
}