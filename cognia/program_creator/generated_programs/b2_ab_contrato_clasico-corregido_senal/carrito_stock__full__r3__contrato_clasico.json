{
  "nombre": "Validación del carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Estado inicial: productos y carrito vacíos",
      "critico": true,
      "acciones": [
        {
          "accion": "contar",
          "selector": ".prod",
          "esperado": 3
        },
        {
          "accion": "contar_visible",
          "selector": ".linea",
          "esperado": 0
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "0"
        }
      ]
    },
    {
      "nombre": "Agregar primer producto (p1)",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": "button.add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": ".linea[data-id='p1']",
          "esperado": 1
        },
        {
          "accion": "texto",
          "selector": "div.linea[data-id='p1'] .cant",
          "contiene": "1"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "100"
        }
      ]
    },
    {
      "nombre": "Agregar mismo producto (p1) hasta stock máximo",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": "button.add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "click",
          "selector": "button.add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": "div.linea[data-id='p1'] .cant",
          "esperado": 2
        },
        {
          "accion": "existe",
          "selector": "button.add[data-id='p1'][disabled]"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "200"
        }
      ]
    },
    {
      "nombre": "Intentar exceder stock de p1 y verificar botón deshabilitado",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": "button.add[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": "div.linea[data-id='p1'] .cant",
          "esperado": 2
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "200"
        }
      ]
    },
    {
      "nombre": "Agregar otro producto (p2) y verificar suma total",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": "button.add[data-id='p2']",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": "div.linea[data-id='p2'] .cant",
          "esperado": 1
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "250"
        }
      ]
    },
    {
      "nombre": "Quitar una unidad de p1 y verificar decremento",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": "button.quitar[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": "div.linea[data-id='p1'] .cant",
          "esperado": 1
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "150"
        }
      ]
    },
    {
      "nombre": "Quitar última unidad de p1 y verificar línea desaparece",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": "button.quitar[data-id='p1']",
          "indice": 0
        },
        {
          "accion": "no_existe",
          "selector": "div.linea[data-id='p1']"
        },
        {
          "accion": "existe",
          "selector": "button.add[data-id='p1']"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "50"
        }
      ]
    },
    {
      "nombre": "Verificar que botón add de p1 se habilita tras eliminar línea",
      "critico": true,
      "acciones": [
        {
          "accion": "existe",
          "selector": "button.add[data-id='p1']"
        },
        {
          "accion": "no_existe",
          "selector": "button.add[data-id='p1'][disabled]"
        }
      ]
    }
  ]
}