{
  "nombre": "Verificar funcionalidad de mini hoja de cálculo 3x3",
  "pasos": [
    {
      "nombre": "Existe la grilla 3x3 de celdas",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Cada celda tiene atributo data-ref correcto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).map(c=>c.dataset.ref)",
      "esperado": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "B3",
        "C1",
        "C2",
        "C3"
      ],
      "critico": true
    },
    {
      "nombre": "Valor inicial de todas las celdas es vacío",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(c=>c.value==='')",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Escribir fórmula en A1 y verificar cálculo",
      "accion": "escribir",
      "selector": ".celda[data-ref='A1']",
      "texto": "=1+2",
      "critico": true
    },
    {
      "nombre": "Verificar que A1 muestra resultado 3",
      "accion": "js",
      "expr": "document.querySelector('.celda[data-ref=\"A1\"]').value",
      "esperado": "3",
      "critico": true
    },
    {
      "nombre": "Escribir referencia a A1 en B1 y verificar cascada",
      "accion": "escribir",
      "selector": ".celda[data-ref='B1']",
      "texto": "=A1+1",
      "critico": true
    },
    {
      "nombre": "Cambiar valor de A1 a 5 y verificar actualización de B1",
      "accion": "escribir",
      "selector": ".celda[data-ref='A1']",
      "texto": "5",
      "critico": true
    },
    {
      "nombre": "Crear referencia circular C1->B1 y B1->C1 y verificar texto CIRC",
      "accion": "escribir",
      "selector": ".celda[data-ref='C1']",
      "texto": "=B1",
      "critico": true
    },
    {
      "nombre": "Escribir en B1 referencia a C1 y verificar CIRC en C1",
      "accion": "escribir",
      "selector": ".celda[data-ref='B1']",
      "texto": "=C1+1",
      "critico": true
    },
    {
      "nombre": "Verificar que C1 muestra texto CIRC",
      "accion": "js",
      "expr": "document.querySelector('.celda[data-ref=\"C1\"]').value",
      "esperado": "CIRC",
      "critico": true
    }
  ]
}