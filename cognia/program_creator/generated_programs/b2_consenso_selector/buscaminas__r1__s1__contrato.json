{
  "nombre": "Contrato de prueba para el buscaminas 5x5",
  "pasos": [
    {
      "nombre": "Verificar que hay 25 celdas con clase 'c'",
      "accion": "contar",
      "selector": ".c",
      "esperado": 25,
      "critico": true
    },
    {
      "nombre": "Verificar que las celdas tienen data-i de 0 a 24",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.c')).every(c => c.dataset.i >= 0 && c.dataset.i <= 24)",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Verificar que las celdas 6, 12 y 18 contienen minas",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.c')).filter(c => [6, 12, 18].includes(parseInt(c.dataset.i))).every(c => c.classList.contains('mina'))",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Abrir una celda sin minas adyacentes y verificar que se abren en cascada",
      "accion": "click",
      "selector": ".c",
      "indice": 0,
      "esperado": null,
      "critico": true
    },
    {
      "nombre": "Verificar que se muestra el número de minas adyacentes en una celda abierta",
      "accion": "contar_visible",
      "selector": ".c.abierta",
      "esperado": 3,
      "critico": true
    },
    {
      "nombre": "Poner una bandera en una celda y verificar que no se abre al hacer click",
      "accion": "click",
      "selector": ".c",
      "indice": 1,
      "esperado": null,
      "critico": true
    },
    {
      "nombre": "Abrir una celda con una mina y verificar que se muestra 'perdiste'",
      "accion": "click",
      "selector": ".c",
      "indice": 6,
      "esperado": null,
      "critico": true
    },
    {
      "nombre": "Verificar que el estado muestra 'perdiste' al abrir una mina",
      "accion": "texto",
      "selector": "#estado",
      "contiene": "perdiste",
      "esperado": null,
      "critico": true
    }
  ]
}