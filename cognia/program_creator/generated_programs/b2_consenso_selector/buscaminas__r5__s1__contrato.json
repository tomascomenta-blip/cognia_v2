{
  "nombre": "Contrato de prueba para buscaminas 5x5",
  "pasos": [
    {
      "nombre": "Verificar que hay 25 celdas con clase 'c'",
      "accion": "contar",
      "selector": ".c",
      "esperado": 25,
      "critico": true
    },
    {
      "nombre": "Verificar que las minas están en las celdas 6, 12 y 18",
      "accion": "js",
      "expr": "document.querySelectorAll('.c[data-i=\"6\"][data-mina], .c[data-i=\"12\"][data-mina], .c[data-i=\"18\"][data-mina]').length",
      "esperado": 3,
      "critico": true
    },
    {
      "nombre": "Abrir una celda sin minas adyacentes y verificar que se abren en cascada",
      "accion": "click",
      "selector": ".c",
      "indice": 0,
      "esperado": "abierta",
      "critico": true
    },
    {
      "nombre": "Verificar que se puede poner una bandera en una celda",
      "accion": "click",
      "selector": ".c",
      "indice": 1,
      "esperado": "bandera",
      "critico": true
    },
    {
      "nombre": "Verificar que una celda con bandera no se abre al hacer click",
      "accion": "click",
      "selector": ".c",
      "indice": 1,
      "esperado": "bandera",
      "critico": true
    },
    {
      "nombre": "Abrir una celda con mina y verificar que se pierde",
      "accion": "click",
      "selector": ".c",
      "indice": 6,
      "esperado": "perdiste",
      "critico": true
    },
    {
      "nombre": "Verificar que las celdas con minas tienen la clase 'mina'",
      "accion": "js",
      "expr": "document.querySelectorAll('.c[data-mina].mina').length",
      "esperado": 3,
      "critico": true
    },
    {
      "nombre": "Verificar que las celdas abiertas muestran el número de minas adyacentes",
      "accion": "contar_visible",
      "selector": ".c.abierta:not([data-mina])",
      "esperado": 22,
      "critico": true
    }
  ]
}