{
  "nombre": "Carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Existen 3 productos",
      "critico": true,
      "acciones": [
        {
          "accion": "contar",
          "selector": ".prod",
          "esperado": 3
        }
      ]
    },
    {
      "nombre": "Existen 3 botones de añadir",
      "critico": true,
      "acciones": [
        {
          "accion": "contar",
          "selector": ".add",
          "esperado": 3
        }
      ]
    },
    {
      "nombre": "Existen 3 productos con stock suficiente",
      "critico": true,
      "acciones": [
        {
          "accion": "js",
          "expr": "document.querySelectorAll('.prod').every(p => parseInt(p.getAttribute('data-stock')) > 0)",
          "esperado": true
        }
      ]
    },
    {
      "nombre": "Añadir un producto no crea una línea nueva",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 1
        }
      ]
    },
    {
      "nombre": "No se puede superar el stock de un producto",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0,
          "repeticiones": 3
        },
        {
          "accion": "existe",
          "selector": ".add[data-id='p1'][disabled]"
        }
      ]
    },
    {
      "nombre": "Quitar una unidad de un producto hace que la línea desaparezca",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0
        },
        {
          "accion": "no_existe",
          "selector": ".linea[data-id='p1']"
        }
      ]
    },
    {
      "nombre": "El total se recalcula siempre",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "click",
          "selector": ".add",
          "indice": 1
        },
        {
          "accion": "js",
          "expr": "parseInt(document.getElementById('total').textContent)",
          "esperado": 150
        }
      ]
    },
    {
      "nombre": "El botón de añadir vuelve a habilitarse cuando la cantidad llega a 0",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0,
          "repeticiones": 2
        },
        {
          "accion": "no_existe",
          "selector": ".linea[data-id='p1']"
        },
        {
          "accion": "existe",
          "selector": ".add[data-id='p1']:not([disabled])"
        }
      ]
    }
  ]
}