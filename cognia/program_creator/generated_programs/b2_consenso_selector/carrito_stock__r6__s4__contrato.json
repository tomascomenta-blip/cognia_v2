{
  "nombre": "Carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Existen 3 productos",
      "critico": true,
      "accion": "contar",
      "selector": ".prod",
      "esperado": 3
    },
    {
      "nombre": "Existen 3 botones de añadir",
      "critico": true,
      "accion": "contar",
      "selector": ".add",
      "esperado": 3
    },
    {
      "nombre": "Existen 3 productos con stock",
      "critico": true,
      "accion": "js",
      "expr": "document.querySelectorAll('.prod').every(p => p.dataset.stock > 0)",
      "esperado": true
    },
    {
      "nombre": "Añadir un producto no crea una línea nueva",
      "critico": true,
      "accion": "contar",
      "selector": ".linea",
      "indice": 0,
      "esperar": 1000,
      "esperado": 1
    },
    {
      "nombre": "No se puede superar el stock",
      "critico": true,
      "accion": "existe",
      "selector": ".add[data-id='p1']:disabled",
      "indice": 0,
      "esperar": 1000,
      "esperado": true
    },
    {
      "nombre": "Quitar una unidad y desaparece la línea",
      "critico": true,
      "accion": "contar",
      "selector": ".linea",
      "indice": 0,
      "esperar": 1000,
      "esperado": 0
    },
    {
      "nombre": "El total se recalcula siempre",
      "critico": true,
      "accion": "js",
      "selector": ".add",
      "indice": 2,
      "esperar": 1000,
      "expr": "parseInt(document.getElementById('total').textContent)",
      "esperado": 175
    },
    {
      "nombre": "El botón add vuelve a habilitarse al quitar una unidad",
      "critico": true,
      "accion": "existe",
      "selector": ".add[data-id='p1']:not([disabled])",
      "indice": 0,
      "esperar": 1000,
      "esperado": true
    }
  ]
}