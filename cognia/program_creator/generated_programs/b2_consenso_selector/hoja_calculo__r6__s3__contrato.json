{
  "nombre": "Mini hoja de cálculo en HTML",
  "pasos": [
    {
      "nombre": "Existen 9 celdas con clase 'celda'",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Existen 1 elemento con clase 'grid'",
      "accion": "contar",
      "selector": ".grid",
      "esperado": 1,
      "critico": true
    },
    {
      "nombre": "Cada celda tiene un atributo 'data-ref' único",
      "accion": "js",
      "expr": "new Set([...document.querySelectorAll('.celda')].map(el => el.getAttribute('data-ref'))).size === 9",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Al cambiar una celda, se recalculan las dependientes",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "5",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Celda con fórmula muestra resultado calculado",
      "accion": "texto",
      "selector": ".celda[data-ref='B1']",
      "contiene": "6",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Celda con fórmula dependiente muestra resultado actualizado",
      "accion": "texto",
      "selector": ".celda[data-ref='C1']",
      "contiene": "7",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Celda con referencia circular muestra 'CIRC'",
      "accion": "texto",
      "selector": ".celda[data-ref='A2']",
      "contiene": "CIRC",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Celda con fórmula dependiente de circular muestra 'CIRC'",
      "accion": "texto",
      "selector": ".celda[data-ref='B2']",
      "contiene": "CIRC",
      "esperado": true,
      "critico": true
    }
  ]
