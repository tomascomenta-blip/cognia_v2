{
  "nombre": "Verificar funcionalidad de mini hoja de cálculo 3x3",
  "pasos": [
    {
      "nombre": "Existe la grilla 3x3 con 9 celdas",
      "critico": true,
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9
    },
    {
      "nombre": "Cada celda tiene atributo data-ref correcto",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).map(c=>c.dataset.ref)",
      "esperado": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "B3",
        "C1",
        "C2",
        "C3"
      ]
    },
    {
      "nombre": "Valor inicial de todas las celdas es vacío",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(c=>c.value==='')",
      "esperado": true
    },
    {
      "nombre": "Escribir valor numérico en A1 y verificar que se muestra",
      "critico": true,
      "accion": "escribir",
      "selector": ".celda[data-ref='A1']",
      "texto": "5"
    },
    {
      "nombre": "Escribir fórmula en B1 que dependa de A1 y verificar cálculo",
      "critico": true,
      "accion": "escribir",
      "selector": ".celda[data-ref='B1']",
      "texto": "=A1+3"
    },
    {
      "nombre": "Cambiar valor de A1 y comprobar que B1 se recalcula automáticamente",
      "critico": true,
      "accion": "escribir",
      "selector": ".celda[data-ref='A1']",
      "texto": "10"
    },
    {
      "nombre": "Crear cadena de dependencias C1=B1+2 y verificar cascada al cambiar A1",
      "critico": true,
      "accion": "escribir",
      "selector": ".celda[data-ref='C1']",
      "texto": "=B1+2"
    },
    {
      "nombre": "Introducir referencia circular en A2 y comprobar que muestra 'CIRC'",
      "critico": true,
      "accion": "escribir",
      "selector": ".celda[data-ref='A2']",
      "texto": "=C1"
    }
  ]
}