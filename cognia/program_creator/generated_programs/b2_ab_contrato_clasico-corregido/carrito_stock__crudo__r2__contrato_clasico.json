{
  "nombre": "Carrito de compra con stock",
  "pasos": [
    {
      "nombre": "Estado inicial: 3 productos y carrito vacío",
      "critico": true,
      "acciones": [
        {
          "accion": "contar",
          "selector": ".prod",
          "esperado": 3
        },
        {
          "accion": "contar",
          "selector": ".add",
          "esperado": 3
        },
        {
          "accion": "contar",
          "selector": ".linea",
          "esperado": 0
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "0"
        }
      ]
    },
    {
      "nombre": "Añadir primer producto (p1)",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": ".linea",
          "esperado": 1
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "100"
        }
      ]
    },
    {
      "nombre": "Añadir mismo producto p1 nuevamente",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": ".linea",
          "esperado": 1
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "200"
        }
      ]
    },
    {
      "nombre": "Añadir tercer producto (p3) hasta límite de stock",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 2
        },
        {
          "accion": "click",
          "selector": ".add",
          "indice": 2
        },
        {
          "accion": "click",
          "selector": ".add",
          "indice": 2
        },
        {
          "accion": "existe",
          "selector": ".add[data-id=\"p3\"]:disabled"
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "250"
        }
      ]
    },
    {
      "nombre": "Quitar una unidad de p1",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "100"
        }
      ]
    },
    {
      "nombre": "Quitar dos unidades de p1, línea desaparece",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0
        },
        {
          "accion": "click",
          "selector": ".quitar",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": ".linea",
          "esperado": 2
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "0"
        }
      ]
    },
    {
      "nombre": "Reactivar botón add de p1 tras quitar todas unidades",
      "critico": true,
      "acciones": [
        {
          "accion": "existe",
          "selector": ".add[data-id=\"p1\"]"
        },
        {
          "accion": "no_existe",
          "selector": ".add[data-id=\"p1\"]:disabled"
        }
      ]
    },
    {
      "nombre": "Añadir p1 una vez más, línea se crea y total actualiza",
      "critico": true,
      "acciones": [
        {
          "accion": "click",
          "selector": ".add",
          "indice": 0
        },
        {
          "accion": "contar_visible",
          "selector": ".linea",
          "esperado": 3
        },
        {
          "accion": "texto",
          "selector": "#total",
          "contiene": "100"
        }
      ]
    }
  ]
}