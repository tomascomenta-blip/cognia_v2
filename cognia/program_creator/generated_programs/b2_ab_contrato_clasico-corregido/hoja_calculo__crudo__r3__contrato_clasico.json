{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de la grilla 3x3",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Confirmar que cada celda tiene atributo data-ref correcto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every((c,i)=>c.dataset.ref===['A1','A2','A3','B1','B2','B3','C1','C2','C3'][i])",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Asegurar que el valor inicial de todas las celdas es vacío",
      "accion": "contar_visible",
      "selector": ".celda",
      "esperado": 0,
      "critico": true
    },
    {
      "nombre": "Ingresar un valor numérico en A1 y verificar que se muestra",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "1",
      "critico": true
    },
    {
      "nombre": "Crear una fórmula en B1 que dependa de A1 y comprobar su cálculo",
      "accion": "texto",
      "selector": ".celda[data-ref='B1']",
      "contiene": "=A1+1",
      "critico": true
    },
    {
      "nombre": "Cambiar el valor de A1 y verificar que B1 se actualiza automáticamente",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "5",
      "critico": true
    },
    {
      "nombre": "Introducir una referencia circular C1= C1+1 y verificar que muestra 'CIRC'",
      "accion": "texto",
      "selector": ".celda[data-ref='C1']",
      "contiene": "CIRC",
      "critico": true
    },
    {
      "nombre": "Confirmar que el atributo value de cada celda refleja su valor calculado o texto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(c=>c.value!=='' )",
      "esperado": true,
      "critico": true
    }
  ]
}