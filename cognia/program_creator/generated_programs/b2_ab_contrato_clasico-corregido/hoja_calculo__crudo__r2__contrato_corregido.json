{
  "nombre": "Verificar hoja de cálculo 3x3 con fórmulas y recálculo",
  "pasos": [
    {
      "nombre": "Existe la grilla con 9 celdas",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Cada celda tiene atributo data-ref correcto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).map(c=>c.dataset.ref).join(',')",
      "esperado": "A1,A2,A3,B1,B2,B3,C1,C2,C3",
      "critico": true
    },
    {
      "nombre": "Celda A1 muestra valor inicial vacío",
      "accion": "js",
      "expr": "document.querySelector('[data-ref=\"A1\"]').value",
      "esperado": "",
      "critico": true
    },
    {
      "nombre": "Escribir 5 en A1 y confirmar valor",
      "accion": "escribir",
      "selector": "[data-ref=\"A1\"]",
      "texto": "5",
      "critico": true
    },
    {
      "nombre": "Escribir fórmula =A1+3 en B1 y verificar resultado 8",
      "accion": "escribir",
      "selector": "[data-ref=\"B1\"]",
      "texto": "=A1+3",
      "critico": true
    },
    {
      "nombre": "Cambiar A1 a 10 y comprobar que B1 actualiza a 13",
      "accion": "escribir",
      "selector": "[data-ref=\"A1\"]",
      "texto": "10",
      "critico": true
    },
    {
      "nombre": "Crear fórmula circular =C1 en C1 y verificar texto CIRC",
      "accion": "escribir",
      "selector": "[data-ref=\"C1\"]",
      "texto": "=C1",
      "critico": true
    },
    {
      "nombre": "Crear fórmula dependiente =B1+1 en C2 y verificar que actualiza a 14 cuando B1 es 13",
      "accion": "escribir",
      "selector": "[data-ref=\"C2\"]",
      "texto": "=B1+1",
      "critico": true
    }
  ]
}