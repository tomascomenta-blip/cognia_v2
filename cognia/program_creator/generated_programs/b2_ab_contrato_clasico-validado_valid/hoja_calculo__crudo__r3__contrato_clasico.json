{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de 9 celdas",
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9,
      "critico": true
    },
    {
      "nombre": "Confirmar que cada celda tiene atributo data-ref correcto",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>['A1','A2','A3','B1','B2','B3','C1','C2','C3'].includes(el.dataset.ref))",
      "esperado": true,
      "critico": true
    },
    {
      "nombre": "Establecer valores iniciales sin fórmulas",
      "accion": "texto",
      "selector": ".celda",
      "contiene": "1",
      "critico": true
    },
    {
      "nombre": "Ingresar fórmula en B1 y verificar cálculo",
      "accion": "texto",
      "selector": ".celda[data-ref='B1']",
      "contiene": "=A1+1",
      "critico": true
    },
    {
      "nombre": "Cambiar valor de A1 y comprobar actualización en B1",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "5",
      "critico": true
    },
    {
      "nombre": "Ingresar fórmula dependiente en C1 y verificar cascada",
      "accion": "texto",
      "selector": ".celda[data-ref='C1']",
      "contiene": "=B1+1",
      "critico": true
    },
    {
      "nombre": "Crear referencia circular y verificar texto CIRC",
      "accion": "texto",
      "selector": ".celda[data-ref='A1']",
      "contiene": "=C1+1",
      "critico": true
    },
    {
      "nombre": "Confirmar que valor mostrado en cada celda es el atributo value",
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>el.value===el.value)",
      "esperado": true,
      "critico": true
    }
  ]
}