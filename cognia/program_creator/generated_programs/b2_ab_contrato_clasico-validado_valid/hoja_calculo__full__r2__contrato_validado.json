{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Contar celdas con clase .celda",
      "critico": true,
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9
    },
    {
      "nombre": "Confirmar que cada celda tiene atributo data-ref correcto",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>['A1','A2','A3','B1','B2','B3','C1','C2','C3'].includes(el.dataset.ref))",
      "esperado": true
    },
    {
      "nombre": "Ingresar fórmula en A2 y verificar cálculo",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='A2']",
      "contiene": "=A1+1"
    },
    {
      "nombre": "Cambiar valor de A1 y comprobar cascada en A2",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='A1']",
      "contiene": "2"
    },
    {
      "nombre": "Crear referencia circular C1=B1 y B1=C1 y verificar texto CIRC",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='C1']",
      "contiene": "CIRC"
    },
    {
      "nombre": "Eliminar referencia circular y comprobar que se actualiza a valor numérico",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='C1']",
      "contiene": "3"
    }
  ],
  "_validado": {
    "antes": 8,
    "despues": 6
  }
}