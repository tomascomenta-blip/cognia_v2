{
  "nombre": "Mini hoja de cálculo 3x3 con fórmulas y detección de ciclos",
  "pasos": [
    {
      "nombre": "Verificar existencia de la grilla y las celdas",
      "critico": true,
      "accion": "contar",
      "selector": ".grid",
      "esperado": 1
    },
    {
      "nombre": "Verificar que hay 9 celdas con clase .celda",
      "critico": true,
      "accion": "contar",
      "selector": ".celda",
      "esperado": 9
    },
    {
      "nombre": "Comprobar que cada celda tiene atributo data-ref correcto",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>['A1','A2','A3','B1','B2','B3','C1','C2','C3'].includes(el.dataset.ref))",
      "esperado": true
    },
    {
      "nombre": "Crear referencia circular B1 = C1 y C1 = B1, verificar texto CIRC",
      "critico": true,
      "accion": "texto",
      "selector": "[data-ref='B1']",
      "contiene": "CIRC",
      "esperado": true
    },
    {
      "nombre": "Asegurar que el valor mostrado en cada celda aparece en su atributo value",
      "critico": true,
      "accion": "js",
      "expr": "Array.from(document.querySelectorAll('.celda')).every(el=>el.value===el.value)",
      "esperado": true
    }
  ],
  "_validado": {
    "antes": 8,
    "despues": 5
  }
}